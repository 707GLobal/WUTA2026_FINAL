Panels:
- Class: rviz_common/Displays
  Help Height: 70
  Name: Displays
  Property Tree Widget:
    Expanded: null
    Splitter Ratio: 0.5
  Tree Height: 88
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 85; 85; 85
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 60
    Reference Frame: <Fixed Frame>
    Value: true
  - Class: fsd_rviz_plugins/SafeImage
    Enabled: true
    Max Value: 1
    Median window: 5
    Min Value: 0
    Name: Camera detections
    Normalize Range: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /camera/yolo/image_annotated
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Name: Camera-guided clusters (fusion)
    Enabled: true
    Topic:
      Value: /perception/fused/guided_clusters_viz
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
      History Policy: Keep Last
    Queue Size: 1
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 255; 255
    Color Transformer: AxisColor
    Decay Time: 0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 4096
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Raw LiDAR (optional)
    Position Transformer: XYZ
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.009999999776482582
    Style: Points
    Topic:
      Depth: 1
      Durability Policy: Volatile
      Filter size: 10
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /hesai/pandar
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Fused targets and sources
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /perception/fused/cones_viz
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Cone map
    Namespaces:
      cone_map: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /mapping/cone_map_viz
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Centerline
    Namespaces:
      centerline: true
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /planning/centerline_viz
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Final planned path
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /planning/final_waypoints_viz
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Driven trajectory
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /planning/driven_trajectory_viz
    Value: true
  - Class: rviz_default_plugins/MarkerArray
    Enabled: true
    Name: Control target
    Namespaces: {}
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /control/target_viz
    Value: true
  - Class: rviz_default_plugins/Marker
    Name: FSD localization speed
    Enabled: true
    Value: true
    Topic:
      Value: /fsd_visualization/speed
      Reliability Policy: Best Effort
      Durability Policy: Volatile
      Depth: 1
      History Policy: Keep Last
    Queue Size: 1
  Enabled: true
  Global Options:
    Background Color: 24; 28; 34
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Interact
    Hide Inactive Objects: true
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 22
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.05999999865889549
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 5
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05000000074505806
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.009999999776482582
      Pitch: 1
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: 0
    Saved: null
Window Geometry:
  Camera detections:
    collapsed: false
  Displays:
    collapsed: false
  Height: 850
  Hide Left Dock: false
  Hide Right Dock: false
  Views:
    collapsed: false
  Width: 1200
  X: 100
  Y: 80
